# ==========================================================
# API EXTERNA
# ==========================================================

# Chave utilizada para acessar a API TheGamesDB.
# Cada usuário deve informar sua própria chave.
THEGAMESDB_API_KEY=


# ==========================================================
# CONFIGURAÇÕES UTILIZADAS PELO GAMEHUB
# ==========================================================

# Dentro do Docker Compose, "mysql" é o nome do serviço
# responsável pelo banco de dados.
DB_HOST=mysql

# Porta padrão do MySQL.
DB_PORT=3306

# Usuário utilizado pela aplicação para acessar o banco.
DB_USER=gamehub

# Defina uma senha para o usuário da aplicação.
# Deve ser a mesma utilizada em MYSQL_PASSWORD.
DB_PASSWORD=

# Nome do banco utilizado pelo GameHub.
DB_NAME=gamehub


# ==========================================================
# CONFIGURAÇÕES UTILIZADAS PELA IMAGEM MYSQL
# ==========================================================

# Senha administrativa do usuário root do MySQL.
MYSQL_ROOT_PASSWORD=

# Banco criado automaticamente na primeira inicialização.
MYSQL_DATABASE=gamehub

# Usuário criado automaticamente para a aplicação.
MYSQL_USER=gamehub

# Senha do usuário criado acima.
# Deve ser igual ao valor definido em DB_PASSWORD.
MYSQL_PASSWORD=